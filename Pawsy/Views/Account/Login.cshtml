@{
  ViewData["Title"] = "Logowanie";
}

<div class="auth-container">
  <div class="content">
    <div class="content-text">
      <h1>Logowanie</h1>
      <p>Witaj z powrotem</p>
    </div>
    <div class="form-area">
      <form>
        <div class="custom-input">
          <input type="email" id="email-input" placeholder="Adres email">
        </div>
        <div class="custom-input">
          <input type="password" id="password-input" placeholder="Hasło">
        </div>
      </form>
    </div>
  </div>
</div>
