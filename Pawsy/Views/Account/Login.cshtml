@{
  ViewData["Title"] = "Logowanie";
}

<div class="auth-container">
  <div class="content">
    <div class="content-text">
      <h1>Logowanie</h1>
      <p>Witaj z powrotem</p>
    </div>
    <div class="form-area">
      <form asp-controller="Account" asp-action="Login" method="POST">
        @Html.AntiForgeryToken()
        @if (ViewData.ModelState.Count > 0)
        {
          <div asp-validation-summary="ModelOnly" class="form-errors"></div>
        }
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

        <div class="custom-input">
          <span class="icon lucide--user" aria-hidden="true"></span>
          <input type="text" id="username-input" name="username" placeholder="Nazwa użytkownika" required minlength="3"
                 maxlength="16">
        </div>
        <div class="custom-input">
          <span class="icon lucide--lock" aria-hidden="true"></span>
          <input type="password" id="password-input" name="password" placeholder="Hasło" required minlength="8"
                 maxlength="32">
        </div>
        <div>
          <input type="checkbox" name="rememberMe" id="rememberMe">
          <label for="rememberMe">Zapamiętaj mnie</label>
        </div>
        <div style="text-align: center;">
          <input type="submit" value="Zaloguj się" class="pill">
        </div>
      </form>
    </div>
    <div style="text-align: center; margin-top: 24px;">
      <a asp-controller="Account" asp-action="Register">
        Utwórz nowe konto
      </a>
    </div>
  </div>
</div>
