<!DOCTYPE html>
<html lang="pl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pawsy</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />
</head>

<body>
    <header class="main-header">
        <div class="content">
            <div>
                <a asp-controller="Home" asp-action="Index" class="logo-link" title="Przejdź do strony głównej">
                    <img src="~/icons/logo.svg" alt="Pawsy logo" aria-hidden="true">
                    <span class="site-name" aria-hidden="true">Pawsy</span>
                </a>
            </div>
            <div class="right">
                <div class="nav-header">
                    <div class="content">
                        <div class="close-menu-area">
                            <button class="icon-button" title="Zamknij menu" id="close-mobile-menu-btn">
                                <span class="sr-only">Zamknij menu</span>
                                <span class="icon lucide--letter-x" aria-hidden="true"></span>
                            </button>
                        </div>
                        <nav>
                            <a id="home-elem" asp-controller="Home" asp-action="Index" class="nav-elem">
                                <span class="icon lucide--home" aria-hidden="true"></span>
                                <span>strona główna</span>
                            </a>
                            <a asp-controller="Product" asp-action="Index" asp-route-category="pies" class="nav-elem">
                                <span class="icon lucide--dog" aria-hidden="true"></span>
                                <span>pies</span>
                            </a>
                            <a asp-controller="Product" asp-action="Index" asp-route-category="kot" class="nav-elem">
                                <span class="icon lucide--cat" aria-hidden="true"></span>
                                <span>kot</span>
                            </a>
                            <a asp-controller="Product" asp-action="Index" asp-route-category="ptaki" class="nav-elem">
                                <span class="icon lucide--bird" aria-hidden="true"></span>
                                <span>ptaki</span>
                            </a>
                            <a asp-controller="Product" asp-action="Index" asp-route-category="rybki" class="nav-elem">
                                <span class="icon lucide--fish" aria-hidden="true"></span>
                                <span>rybki</span>
                            </a>
                            <a asp-controller="Home" asp-action="Index" class="nav-elem active">
                                <span class="icon lucide--percent" aria-hidden="true"></span>
                                <span>promocje</span>
                            </a>
                            <a asp-controller="UserProfile" asp-action="Index" class="nav-elem">
                                <span class="icon akar-icons--person" aria-hidden="true"></span>
                                <span class="m-only">profil</span>
                            </a>
                            
                            <a asp-controller="Favorites" asp-action="Index" class="nav-elem shop-header-link"
                               aria-label="Przejdź do ulubionych">

                                <span class="icon akar-icons--heart" aria-hidden="true"></span>

                                <span class="m-only">ulubione</span>

                                <span class="shop-header-count" id="favorites-header-count" hidden>0</span>
                            </a>
                        </nav>
                    </div>
                </div>
                <label for="site-search" class="label-search">Wyszukaj:</label>
                <input type="search" id="site-search" name="search" </input>
                <button class="icon-button" id="search-btn">
                    <span class="sr-only">Wyszukaj w sklepie</span>
                    <span class="icon lucide--search" aria-hidden="true"></span>
                </button>
                <a asp-controller="Cart" asp-action="Index" class="icon-button shop-header-link"
                   aria-label="Przejdź do koszyka">

                    <span class="icon akar-icons--cart" aria-hidden="true"></span>

                    <span class="shop-header-count" id="cart-header-count" hidden>0</span>
                </a>
                <button class="icon-button" id="open-mobile-menu-btn">
                    <span class="sr-only">Otwórz menu</span>
                    <span class="icon lucide--menu" aria-hidden="true"></span>
                </button>
            </div>
        </div>
        
    </header>
    <main>
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/nav-header.js"></script>
    <script src="~/js/shop.js" asp-append-version="true"></script>
</body>

</html>
