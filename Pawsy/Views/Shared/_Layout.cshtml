<!DOCTYPE html>
<html lang="pl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pawsy</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/icons.css" asp-append-version="true" />
</head>

<body>
    <header class="main-header">
        <div class="content">
            <div>
                <a asp-controller="Home" asp-action="Index" class="logo-link" title="Przejdź do strony głównej">
                    <img src="~/icons/logo.svg" alt="Pawsy logo" aria-hidden="true">
                    <span class="site-name" aria-hidden="true">Pawsy</span>
                </a>
            </div>
            <div>
                <button class="icon-button">
                    <span class="sr-only">Wyszukaj w skepie</span>
                    <span class="icon lucide--search" aria-hidden="true"></span>
                </button>
                <button class="icon-button" id="open-mobile-menu-btn">
                    <span class="sr-only">Otwórz menu</span>
                    <span class="icon lucide--menu" aria-hidden="true"></span>
                </button>
            </div>
        </div>
        <div class="mobile-nav">
            <div class="content">
                <div class="close-menu-area">
                    <button class="icon-button" title="Zamknij menu" id="close-mobile-menu-btn">
                        <span class="sr-only">Zamknij menu</span>
                        <span class="icon lucide--letter-x" aria-hidden="true"></span>
                    </button>
                </div>
                <nav>
                    <a asp-controller="Home" asp-action="Index" class="nav-elem">
                        <span class="icon lucide--home" aria-hidden="true"></span>
                        <span>strona główna</span>
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="nav-elem">
                        <span class="icon lucide--dog" aria-hidden="true"></span>
                        <span>pies</span>
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="nav-elem">
                        <span class="icon lucide--cat" aria-hidden="true"></span>
                        <span>kot</span>
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="nav-elem">
                        <span class="icon lucide--bird" aria-hidden="true"></span>
                        <span>ptaki</span>
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="nav-elem">
                        <span class="icon lucide--fish" aria-hidden="true"></span>
                        <span>rybki</span>
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="nav-elem active">
                        <span class="icon lucide--percent" aria-hidden="true"></span>
                        <span>promocje</span>
                    </a>
                </nav>
            </div>
        </div>
    </header>
    <main>
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/mobile-nav.js"></script>
</body>

</html>
