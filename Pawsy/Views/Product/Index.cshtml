@model IEnumerable<Pawsy.Models.Product>

@{
    ViewData["Title"] = "Katalog produktów";

    var products = Model?.ToList() ?? new List<Pawsy.Models.Product>();

    var categories = products
        .Select(p => p.Category.Name)
        .Distinct()
        .OrderBy(name => name)
        .ToList();
}

<link rel="stylesheet" href="~/css/products.css" asp-append-version="true" />

<section class="catalog">

    <div class="catalog-heading">
        <p class="catalog-breadcrumb">
            Strona główna / Produkty
        </p>
        <h1>Wszystko dla Twojego pupila</h1>
        <p>Odkryj karmy, zabawki i akcesoria.</p>
    </div>

    <div class="catalog-layout">

        <aside class="catalog-filters">
            <h2>Filtruj produkty</h2>

            <fieldset class="filter-section">
                <legend>Kategoria</legend>

                <label class="filter-option">
                    <input type="radio" name="category" value="all" checked />
                    Wszystkie
                </label>

                @foreach (var category in categories)
                {
                    <label class="filter-option">
                        <input type="radio" name="category" value="@category" />
                        @category
                    </label>
                }
            </fieldset>

            <div class="filter-section">
                <label for="max-price">
                    Maksymalna cena
                </label>

                <input type="number" id="max-price" min="0" step="1" placeholder="np. 150" />
            </div>

            <button id="clear-filters" class="clear-filters" type="button">
                Wyczyść filtry
            </button>
        </aside>

        <div class="catalog-content">

            <div class="catalog-toolbar">
                <span id="product-count">
                    @products.Count produktów
                </span>

                <div class="sort-control">
                    <label for="sort-products">Sortuj:</label>

                    <select id="sort-products">
                        <option value="default">Domyślnie</option>
                        <option value="price-asc">Cena: rosnąco</option>
                        <option value="price-desc">Cena: malejąco</option>
                        <option value="name">Nazwa: A–Z</option>
                    </select>
                </div>
            </div>

            <div class="products-grid" id="products-grid">

                @foreach (var product in products)
                {
                    var image = product.Images.FirstOrDefault();

                    var imagePath = string.IsNullOrWhiteSpace(image)
                        ? "/images/products/placeholder.png"
                        : image;

                    var price = product.OnSale
                        ? product.SalePrice!.Value
                        : product.Price;

                    <article class="product-card" data-category="@product.Category.Name"
                             data-price="@price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                             data-name="@product.Name">

                        <div class="product-image">

                            <img src="@imagePath" alt="@product.Name" loading="lazy"
                                 onerror="this.onerror=null;this.src='/images/products/placeholder.png';" />

                            @if (product.OnSale)
                            {
                                <span class="sale-badge">Promocja</span>
                            }
                            <button type="button" class="favorite-btn" data-product-id="@product.Id"
                                    aria-label="Dodaj @product.Name do ulubionych" aria-pressed="false"
                                    title="Dodaj do ulubionych">

                                <svg class="favorite-heart" xmlns="http://www.w3.org/2000/svg" width="22" height="22"
                                     viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path
                                    d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78z" />
                                </svg>
                            </button>
                        </div>

                        <div class="product-info">

                            <p class="product-category">
                                @product.Subcategory.Name
                            </p>

                            <h3 class="product-name">
                                @product.Name
                            </h3>

                            <div class="product-bottom">

                                <div class="product-pricing">
                                    @if (product.OnSale)
                                    {
                                        <span class="old-price">
                                            @product.Price.ToString("0.00") zł
                                        </span>

                                        <strong class="sale-price">
                                            @product.SalePrice!.Value.ToString("0.00") zł
                                        </strong>
                                    }
                                    else
                                    {
                                        <strong class="product-price">
                                            @product.Price.ToString("0.00") zł
                                        </strong>
                                    }
                                </div>

                                <button type="button" class="add-to-cart" disabled
                                        title="Koszyk nie jest jeszcze zaimplementowany"
                                        aria-label="Koszyk nie jest jeszcze dostępny">
                                    <span class="icon akar-icons--cart" aria-hidden="true"></span>
                                </button>

                            </div>
                        </div>
                    </article>
                }
            </div>

            <p id="empty-products" class="empty-products" hidden>
                Nie znaleziono produktów spełniających wybrane kryteria.
            </p>

        </div>
    </div>
</section>

<script src="~/js/products.js" asp-append-version="true"></script>
